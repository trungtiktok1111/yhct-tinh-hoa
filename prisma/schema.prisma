// Database Postgres trên Supabase. DATABASE_URL dùng connection pooler (6543)
// cho runtime; DIRECT_URL dùng connection trực tiếp (5432) để chạy migration.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Trạng thái thẩm định dùng chung cho mọi nội dung chuyên môn (9.2 trong PRD)
// Draft -> PendingReview -> NeedsRevision / Approved / Rejected -> Retired
model Source {
  id          String   @id @default(cuid())
  title       String
  authorOrOrg String?
  sourceType  String // vd: "Sách", "Văn bản pháp quy", "WHO", "Nghiên cứu"
  year        Int?
  version     String?
  publisherOrUrl String?
  locator     String? // trang/chương/đoạn
  accessedAt  DateTime?
  usageRights String?
  createdAt   DateTime @default(now())

  diseases    Disease[]
  patterns    Pattern[]
  principles  TreatmentPrinciple[]
  formulas    Formula[]
  herbs       Herb[]
  points      AcupuncturePoint[]
  protocols   PointProtocol[]
  therapies   ManualTherapy[]
  claims      Claim[]
  theoryTopics TheoryTopic[]
}

// Lý luận cơ bản YHCT: Âm dương, Ngũ hành, Tạng tượng, Kinh lạc, Khí-Huyết-Tân
// dịch, Tứ chẩn, Bát cương, Bát pháp, và các lý luận nền tảng khác không gắn
// trực tiếp vào 1 bệnh/chứng/bài thuốc/huyệt cụ thể.
model TheoryTopic {
  id          String   @id @default(cuid())
  name        String // vd "Âm Dương", "Ngũ Hành", "Tứ Chẩn — Vọng chẩn"
  category    String? // nhóm lớn: "Âm dương - Ngũ hành", "Tạng tượng", "Kinh lạc", "Khí - Huyết - Tân dịch", "Tứ chẩn", "Bát cương", "Bát pháp", "Lịch sử - Triết lý", ...
  summary     String? // tóm tắt ngắn
  content     String? // nội dung đầy đủ, có thể dài
  keyPoints   String? // ứng dụng lâm sàng / điểm cần nhớ
  status      String @default("DRAFT")
  version     Int          @default(1)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sourceId    String?
  source      Source?      @relation(fields: [sourceId], references: [id])
}

model Disease {
  id            String       @id @default(cuid())
  name          String
  aliases       String? // phân tách bằng dấu ;
  nameModern    String? // tên YHHĐ nếu có, để không gộp khái niệm
  definition    String?
  category      String?
  cause         String?
  mechanism     String? // bệnh cơ
  symptoms      String?
  differential  String? // chẩn đoán phân biệt
  warnings      String?
  status        String @default("DRAFT")
  version       Int          @default(1)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])

  patternLinks  DiseasePattern[]
}

model Pattern {
  id            String       @id @default(cuid())
  name          String // tên chứng hậu
  description   String?
  supportCriteria String? // tiêu chí ủng hộ
  againstCriteria String? // tiêu chí không phù hợp
  keySigns      String?
  missingDataPrompts String? // dữ kiện cần hỏi thêm
  status        String @default("DRAFT")
  version       Int          @default(1)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])

  diseaseLinks  DiseasePattern[]
  principleLinks PatternPrinciple[]
}

// Bệnh <-> chứng hậu (nhiều-nhiều, có ghi chú quan hệ)
model DiseasePattern {
  id         String   @id @default(cuid())
  diseaseId  String
  patternId  String
  relation   String // "có thể gặp" | "cần phân biệt với"
  rationale  String?
  disease    Disease  @relation(fields: [diseaseId], references: [id])
  pattern    Pattern  @relation(fields: [patternId], references: [id])

  @@unique([diseaseId, patternId, relation])
}

model TreatmentPrinciple {
  id          String       @id @default(cuid())
  name        String // pháp trị
  aliases     String?
  description String?
  goal        String?
  scope       String? // tình huống áp dụng
  limitations String?
  status      String @default("DRAFT")
  version     Int          @default(1)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sourceId    String?
  source      Source?      @relation(fields: [sourceId], references: [id])

  patternLinks PatternPrinciple[]
  formulas     Formula[]
  protocols    PointProtocol[]
}

model PatternPrinciple {
  id         String   @id @default(cuid())
  patternId  String
  principleId String
  rationale  String?
  pattern    Pattern  @relation(fields: [patternId], references: [id])
  principle  TreatmentPrinciple @relation(fields: [principleId], references: [id])

  @@unique([patternId, principleId])
}

model Herb {
  id                  String       @id @default(cuid())
  standardName        String
  aliases             String?
  latinName           String?
  family              String? // họ thực vật/động vật/khoáng vật
  partUsed            String?
  origin              String?
  botanicalDescription String? // đặc điểm thực vật/hình thái (thân, lá, hoa, quả...)
  distribution        String? // phân bố
  harvestProcessing   String? // thu hái và sơ chế / bào chế
  storage             String? // bảo quản
  chemicalComposition String? // thành phần hóa học
  natureFlavor        String? // tính vị
  meridians           String? // quy kinh
  actions             String? // công năng (Đông y)
  indications         String? // chủ trị
  modernPharmacology  String? // tác dụng dược lý theo nghiên cứu hiện đại
  dosage              String?
  safetyNotes         String?
  imageUrl            String?
  status        String @default("DRAFT")
  version       Int          @default(1)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])

  formulaLinks  FormulaIngredient[]
  items         Item[]
}

model Formula {
  id            String       @id @default(cuid())
  name          String
  aliases       String?
  origin        String? // cổ điển / biến phương / kinh nghiệm / nội bộ
  indications   String? // chủ trị
  preparation   String?
  modifications String? // gia giảm
  safetyNotes   String?
  status        String @default("DRAFT")
  version       Int          @default(1)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])

  principleId   String?
  principle     TreatmentPrinciple? @relation(fields: [principleId], references: [id])

  ingredients   FormulaIngredient[]
}

model FormulaIngredient {
  id           String  @id @default(cuid())
  formulaId    String
  herbId       String
  amount       String?
  unit         String?
  preparation  String?
  role         String? // quân | thần | tá | sứ
  note         String?
  formula      Formula @relation(fields: [formulaId], references: [id])
  herb         Herb    @relation(fields: [herbId], references: [id])
}

model AcupuncturePoint {
  id            String       @id @default(cuid())
  code          String // vd LI4
  standardName  String
  aliases       String?
  meridian      String?
  location      String?
  anatomyNotes  String?
  actions       String?
  technique     String?
  contraindications String?
  riskNotes     String?
  imageUrl      String?
  status        String @default("DRAFT")
  version       Int          @default(1)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])

  protocolLinks PointProtocolItem[]
}

model PointProtocol {
  id          String       @id @default(cuid())
  name        String
  goal        String?
  conditions  String?
  warnings    String?
  status      String @default("DRAFT")
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sourceId    String?
  source      Source?      @relation(fields: [sourceId], references: [id])

  principleId String?
  principle   TreatmentPrinciple? @relation(fields: [principleId], references: [id])

  points      PointProtocolItem[]
}

model PointProtocolItem {
  id         String   @id @default(cuid())
  protocolId String
  pointId    String
  role       String?
  note       String?
  protocol   PointProtocol    @relation(fields: [protocolId], references: [id])
  point      AcupuncturePoint @relation(fields: [pointId], references: [id])
}

model ManualTherapy {
  id            String       @id @default(cuid())
  name          String
  techniqueType String?
  targetArea    String?
  sequence      String?
  indications   String?
  contraindications String?
  durationForce String?
  imageUrl      String?
  status        String @default("DRAFT")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])
}

// Ca lâm sàng — chưa bật form nhập đầy đủ ở bản đầu, model sẵn để mở rộng
model ClinicalCase {
  id              String   @id @default(cuid())
  caseCode        String
  minimalIdentity String? // dữ liệu định danh tối thiểu, đã ẩn danh
  history         String?
  observations     String? // tứ chẩn dạng JSON string
  candidatePatterns String? // JSON: danh sách chứng hậu ứng viên + lý do
  confirmedConclusion String?
  plan            String?
  actualTreatment String?
  outcome         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Nhận định có căn cứ — dùng để ghi "vì sao X liên quan Y" kèm trích dẫn
model Claim {
  id           String       @id @default(cuid())
  subjectType  String // "Pattern" | "Formula" | ...
  subjectId    String
  statement    String
  relation     String?
  status       String @default("PENDING_REVIEW")
  reviewedBy   String?
  reviewedAt   DateTime?

  sourceId     String?
  source       Source?      @relation(fields: [sourceId], references: [id])
}

// ===== Hệ thống phòng khám: chi nhánh, nhân viên, phân quyền, nhật ký =====

// Chi nhánh. Mọi bảng giao dịch về sau (kho, khám, hóa đơn) đều gắn branchId.
model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  staff     StaffBranch[]
  stockLots  StockLot[]
  stockMoves StockMove[]
  visits     Visit[]
  invoices   Invoice[]
}

// Nhân viên. role: OWNER | BRANCH_MANAGER | RECEPTION | DOCTOR | CASHIER | PHARMACIST | STOREKEEPER
// OWNER thấy mọi chi nhánh; các vai trò khác chỉ thấy chi nhánh được gán (StaffBranch).
model Staff {
  id           String    @id @default(cuid())
  username     String    @unique
  fullName     String
  passwordHash String
  role         String
  active       Boolean   @default(true)
  birthDate   DateTime?
  sex         String? // M | F | O
  nationalId  String?  @unique // CCCD / CMND
  phone       String?
  email       String?
  address     String?
  ward        String?
  district    String?
  province    String?
  jobTitle    String? // chức danh
  licenseNo   String? // số chứng chỉ hành nghề
  hireDate    DateTime?
  note        String?
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  branches     StaffBranch[]
  auditLogs    AuditLog[]
}

model StaffBranch {
  staffId  String
  branchId String
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([staffId, branchId])
}

// Nhật ký thao tác. Chỉ thêm, không sửa/xóa.
model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  staffId   String?
  staffName String?
  branchId  String?
  action    String // vd: LOGIN, LOGIN_FAILED, CREATE, UPDATE, DELETE
  entity    String // vd: Staff, Branch, Disease
  entityId  String?
  detail    String?

  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([entity, entityId])
}

// ---------- Kho và giá ----------

// Mặt hàng bán/dùng: dược liệu (tính theo gam) hoặc thành phẩm (viên, hộp, chai...).
model Item {
  id        String   @id @default(cuid())
  name      String
  type      String // HERB | PRODUCT
  unit      String // "g" cho dược liệu; viên/hộp/chai/... cho thành phẩm
  herbId    String? // liên kết vị thuốc trong phần tri thức (nếu trùng tên)
  herb      Herb?    @relation(fields: [herbId], references: [id], onDelete: SetNull)
  minStock  Float    @default(0) // dưới mức này thì cảnh báo sắp hết
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  prices ItemPrice[]
  lots   StockLot[]
  moves  StockMove[]
  prescriptionLines PrescriptionLine[]

  @@index([name])
}

// Giá bán chung toàn hệ thống; giá hiện hành là dòng có effectiveFrom mới nhất. Giữ lịch sử.
model ItemPrice {
  id            String   @id @default(cuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  price         Int // đồng / đơn vị (dược liệu: đồng / gam)
  effectiveFrom DateTime @default(now())
  staffName     String?

  @@index([itemId, effectiveFrom])
}

// Lô nhập: mỗi lần nhập là một lô, có giá nhập và hạn dùng.
model StockLot {
  id           String    @id @default(cuid())
  itemId       String
  item         Item      @relation(fields: [itemId], references: [id])
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id])
  supplier     String?
  receivedAt   DateTime  @default(now())
  expiryDate   DateTime?
  unitCost     Int // giá nhập / đơn vị
  qtyReceived  Float
  qtyRemaining Float
  note         String?
  staffName    String?
  moves        StockMove[]

  @@index([itemId, branchId])
}

// Sổ kho: mọi biến động đều có dòng ở đây (chỉ thêm). qty dương = nhập, âm = xuất.
model StockMove {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  lotId     String?
  lot       StockLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  type      String // RECEIPT | ADJUST
  qty       Float
  reason    String?
  staffName String?

  @@index([branchId, at])
  @@index([itemId])
}

// ---------- Bệnh nhân và lượt khám ----------

// Hồ sơ bệnh nhân dùng chung toàn hệ thống (mọi chi nhánh).
model Patient {
  id               String   @id @default(cuid())
  seq              Int      @unique @default(autoincrement()) // mã BN-000123
  fullName         String
  birthYear        Int // suy ra từ birthDate (giữ để tương thích dữ liệu cũ)
  birthDate        DateTime? // ngày sinh đầy đủ (lưu 00:00 UTC của ngày đó)
  sex              String // M | F | O
  phone            String
  nationalId       String?  @unique // CCCD / CMND / hộ chiếu
  ethnicity        String? // dân tộc
  nationality      String? // quốc tịch
  email            String?
  address          String? // số nhà, đường
  ward             String? // phường / xã
  district         String? // quận / huyện
  province         String? // tỉnh / thành phố
  occupation       String?
  bloodType        String?
  insuranceNo      String? // số thẻ BHYT
  emergencyName    String? // người liên hệ khẩn cấp
  emergencyRelation String?
  emergencyPhone   String?
  weightKg         Float? // lần đo gần nhất
  heightCm         Float?
  pastHistory      String? // tiền căn bản thân
  familyHistory    String? // tiền căn gia đình
  allergies        String? // dị ứng
  chronicConditions String? // bệnh mạn tính đang có
  note             String?
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  visits Visit[]
  invoices Invoice[]

  @@index([fullName])
  @@index([phone])
}

// Một lượt đến khám tại một chi nhánh.
model Visit {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  queueNo     Int // số thứ tự trong ngày tại chi nhánh
  status      String   @default("WAITING") // WAITING | IN_EXAM | DONE | CANCELLED
  reason      String? // lý do khám
  weightKg    Float?
  heightCm    Float?
  pulse       Int?
  bloodPressure String?
  temperature Float?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam        Exam?
  invoice     Invoice?

  @@index([branchId, createdAt])
  @@index([patientId])
}

// ---------- Khám bệnh ----------

// Bệnh án của một lượt khám. Chứng hậu, pháp trị... lưu cả mã gợi ý lẫn chữ (bác sĩ có thể gõ tay).
model Exam {
  id            String   @id @default(cuid())
  visitId       String   @unique
  visit         Visit    @relation(fields: [visitId], references: [id])
  doctorId      String?
  doctorName    String?
  status        String   @default("DRAFT") // DRAFT | FINAL
  chiefComplaint String? // lý do khám chính
  presentHistory String? // bệnh sử
  inspection    String? // vọng
  listening     String? // văn
  inquiry       String? // vấn
  palpation     String? // thiết (mạch, sờ nắn)
  modernDiagnosis String? // chẩn đoán YHHĐ (nếu có)
  exteriorInterior String? // BIEU | LY
  coldHeat      String? // HAN | NHIET
  deficiencyExcess String? // HU | THUC
  yinYang       String? // AM | DUONG
  eightMethods  String? // bát pháp, phân tách bằng dấu phẩy
  diseaseId     String?
  diseaseText   String? // bệnh danh YHCT
  patternId     String?
  patternText   String? // chứng hậu
  principleId   String?
  principleText String? // pháp trị
  advice        String? // dặn dò, kiêng kỵ
  followUpDate  DateTime?
  finalAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  points       ExamPoint[]
  therapies    ExamTherapy[]
  prescription Prescription?
}

model ExamPoint {
  id      String @id @default(cuid())
  examId  String
  exam    Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  pointId String?
  label   String // "LI4 — Hợp cốc"
  note    String?
}

model ExamTherapy {
  id        String @id @default(cuid())
  examId    String
  exam      Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  therapyId String?
  label     String
  note      String?
}

// Đơn thuốc của lượt khám: thuốc sắc (vị thuốc, gam mỗi thang) và thành phẩm.
model Prescription {
  id           String @id @default(cuid())
  examId       String @unique
  exam         Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  thangCount   Int    @default(0) // số thang
  decoctionNote String? // cách sắc, cách uống
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines PrescriptionLine[]
}

model PrescriptionLine {
  id             String @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  kind           String // HERB | PRODUCT
  itemId         String
  item           Item   @relation(fields: [itemId], references: [id])
  itemName       String // ghi lại tên lúc kê
  unit           String
  qty            Float // dược liệu: gam mỗi thang; thành phẩm: tổng số lượng
  usage          String? // cách dùng (thành phẩm)
  note           String? // sao, tẩm, sắc trước...
  position       Int    @default(0)
}

// Hóa đơn: kind EXAM (từ lượt khám) hoặc RETAIL (bán thuốc lẻ, không khám).
// status UNPAID | PAID | VOID. Tiền là số nguyên đồng.
model Invoice {
  id           String   @id @default(cuid())
  seq          Int      @unique @default(autoincrement())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  visitId      String?  @unique
  visit        Visit?   @relation(fields: [visitId], references: [id])
  patientId    String?
  patient      Patient? @relation(fields: [patientId], references: [id])
  customerName String?
  kind         String
  status       String   @default("UNPAID")
  subtotal     Int
  discount     Int      @default(0)
  total        Int
  method       String? // CASH | TRANSFER | CARD
  paidAt       DateTime?
  voidReason   String?
  note         String?
  staffId      String?
  staffName    String?
  createdAt    DateTime @default(now())

  lines InvoiceLine[]

  @@index([branchId, createdAt])
  @@index([status])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind      String // FEE | HERB | PRODUCT
  itemId    String?
  name      String
  unit      String
  qty       Float
  unitPrice Int
  amount    Int
  position  Int     @default(0)
}
