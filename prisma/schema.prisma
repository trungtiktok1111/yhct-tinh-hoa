// Database Postgres trên Supabase. DATABASE_URL dùng connection pooler (6543)
// cho runtime; DIRECT_URL dùng connection trực tiếp (5432) để chạy migration.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Trạng thái thẩm định dùng chung cho mọi nội dung chuyên môn (9.2 trong PRD)
// Draft -> PendingReview -> NeedsRevision / Approved / Rejected -> Retired
model Source {
  id          String   @id @default(cuid())
  title       String
  authorOrOrg String?
  sourceType  String // vd: "Sách", "Văn bản pháp quy", "WHO", "Nghiên cứu"
  year        Int?
  version     String?
  publisherOrUrl String?
  locator     String? // trang/chương/đoạn
  accessedAt  DateTime?
  usageRights String?
  createdAt   DateTime @default(now())

  diseases    Disease[]
  patterns    Pattern[]
  principles  TreatmentPrinciple[]
  formulas    Formula[]
  herbs       Herb[]
  points      AcupuncturePoint[]
  protocols   PointProtocol[]
  therapies   ManualTherapy[]
  claims      Claim[]
  theoryTopics TheoryTopic[]
}

// Lý luận cơ bản YHCT: Âm dương, Ngũ hành, Tạng tượng, Kinh lạc, Khí-Huyết-Tân
// dịch, Tứ chẩn, Bát cương, Bát pháp, và các lý luận nền tảng khác không gắn
// trực tiếp vào 1 bệnh/chứng/bài thuốc/huyệt cụ thể.
model TheoryTopic {
  id          String   @id @default(cuid())
  name        String // vd "Âm Dương", "Ngũ Hành", "Tứ Chẩn — Vọng chẩn"
  category    String? // nhóm lớn: "Âm dương - Ngũ hành", "Tạng tượng", "Kinh lạc", "Khí - Huyết - Tân dịch", "Tứ chẩn", "Bát cương", "Bát pháp", "Lịch sử - Triết lý", ...
  summary     String? // tóm tắt ngắn
  content     String? // nội dung đầy đủ, có thể dài
  keyPoints   String? // ứng dụng lâm sàng / điểm cần nhớ
  status      String @default("DRAFT")
  version     Int          @default(1)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sourceId    String?
  source      Source?      @relation(fields: [sourceId], references: [id])
}

model Disease {
  id            String       @id @default(cuid())
  name          String
  aliases       String? // phân tách bằng dấu ;
  nameModern    String? // tên YHHĐ nếu có, để không gộp khái niệm
  definition    String?
  category      String?
  cause         String?
  mechanism     String? // bệnh cơ
  symptoms      String?
  differential  String? // chẩn đoán phân biệt
  warnings      String?
  status        String @default("DRAFT")
  version       Int          @default(1)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])

  patternLinks  DiseasePattern[]
}

model Pattern {
  id            String       @id @default(cuid())
  name          String // tên chứng hậu
  description   String?
  supportCriteria String? // tiêu chí ủng hộ
  againstCriteria String? // tiêu chí không phù hợp
  keySigns      String?
  missingDataPrompts String? // dữ kiện cần hỏi thêm
  status        String @default("DRAFT")
  version       Int          @default(1)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])

  diseaseLinks  DiseasePattern[]
  principleLinks PatternPrinciple[]
}

// Bệnh <-> chứng hậu (nhiều-nhiều, có ghi chú quan hệ)
model DiseasePattern {
  id         String   @id @default(cuid())
  diseaseId  String
  patternId  String
  relation   String // "có thể gặp" | "cần phân biệt với"
  rationale  String?
  disease    Disease  @relation(fields: [diseaseId], references: [id])
  pattern    Pattern  @relation(fields: [patternId], references: [id])

  @@unique([diseaseId, patternId, relation])
}

model TreatmentPrinciple {
  id          String       @id @default(cuid())
  name        String // pháp trị
  aliases     String?
  description String?
  goal        String?
  scope       String? // tình huống áp dụng
  limitations String?
  status      String @default("DRAFT")
  version     Int          @default(1)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sourceId    String?
  source      Source?      @relation(fields: [sourceId], references: [id])

  patternLinks PatternPrinciple[]
  formulas     Formula[]
  protocols    PointProtocol[]
}

model PatternPrinciple {
  id         String   @id @default(cuid())
  patternId  String
  principleId String
  rationale  String?
  pattern    Pattern  @relation(fields: [patternId], references: [id])
  principle  TreatmentPrinciple @relation(fields: [principleId], references: [id])

  @@unique([patternId, principleId])
}

model Herb {
  id                  String       @id @default(cuid())
  standardName        String
  aliases             String?
  latinName           String?
  family              String? // họ thực vật/động vật/khoáng vật
  partUsed            String?
  origin              String?
  botanicalDescription String? // đặc điểm thực vật/hình thái (thân, lá, hoa, quả...)
  distribution        String? // phân bố
  harvestProcessing   String? // thu hái và sơ chế / bào chế
  storage             String? // bảo quản
  chemicalComposition String? // thành phần hóa học
  natureFlavor        String? // tính vị
  meridians           String? // quy kinh
  actions             String? // công năng (Đông y)
  indications         String? // chủ trị
  modernPharmacology  String? // tác dụng dược lý theo nghiên cứu hiện đại
  dosage              String?
  safetyNotes         String?
  imageUrl            String?
  status        String @default("DRAFT")
  version       Int          @default(1)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])

  formulaLinks  FormulaIngredient[]
  items         Item[]
}

model Formula {
  id            String       @id @default(cuid())
  name          String
  aliases       String?
  origin        String? // cổ điển / biến phương / kinh nghiệm / nội bộ
  indications   String? // chủ trị
  preparation   String?
  modifications String? // gia giảm
  safetyNotes   String?
  status        String @default("DRAFT")
  version       Int          @default(1)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])

  principleId   String?
  principle     TreatmentPrinciple? @relation(fields: [principleId], references: [id])

  ingredients   FormulaIngredient[]
}

model FormulaIngredient {
  id           String  @id @default(cuid())
  formulaId    String
  herbId       String
  amount       String?
  unit         String?
  preparation  String?
  role         String? // quân | thần | tá | sứ
  note         String?
  formula      Formula @relation(fields: [formulaId], references: [id])
  herb         Herb    @relation(fields: [herbId], references: [id])
}

model AcupuncturePoint {
  id            String       @id @default(cuid())
  code          String // vd LI4
  standardName  String
  aliases       String?
  meridian      String?
  location      String?
  anatomyNotes  String?
  actions       String?
  technique     String?
  contraindications String?
  riskNotes     String?
  imageUrl      String?
  status        String @default("DRAFT")
  version       Int          @default(1)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])

  protocolLinks PointProtocolItem[]
}

model PointProtocol {
  id          String       @id @default(cuid())
  name        String
  goal        String?
  conditions  String?
  warnings    String?
  status      String @default("DRAFT")
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  sourceId    String?
  source      Source?      @relation(fields: [sourceId], references: [id])

  principleId String?
  principle   TreatmentPrinciple? @relation(fields: [principleId], references: [id])

  points      PointProtocolItem[]
}

model PointProtocolItem {
  id         String   @id @default(cuid())
  protocolId String
  pointId    String
  role       String?
  note       String?
  protocol   PointProtocol    @relation(fields: [protocolId], references: [id])
  point      AcupuncturePoint @relation(fields: [pointId], references: [id])
}

model ManualTherapy {
  id            String       @id @default(cuid())
  name          String
  techniqueType String?
  targetArea    String?
  sequence      String?
  indications   String?
  contraindications String?
  durationForce String?
  imageUrl      String?
  status        String @default("DRAFT")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sourceId      String?
  source        Source?      @relation(fields: [sourceId], references: [id])
}

// Ca lâm sàng — chưa bật form nhập đầy đủ ở bản đầu, model sẵn để mở rộng
model ClinicalCase {
  id              String   @id @default(cuid())
  caseCode        String
  minimalIdentity String? // dữ liệu định danh tối thiểu, đã ẩn danh
  history         String?
  observations     String? // tứ chẩn dạng JSON string
  candidatePatterns String? // JSON: danh sách chứng hậu ứng viên + lý do
  confirmedConclusion String?
  plan            String?
  actualTreatment String?
  outcome         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Nhận định có căn cứ — dùng để ghi "vì sao X liên quan Y" kèm trích dẫn
model Claim {
  id           String       @id @default(cuid())
  subjectType  String // "Pattern" | "Formula" | ...
  subjectId    String
  statement    String
  relation     String?
  status       String @default("PENDING_REVIEW")
  reviewedBy   String?
  reviewedAt   DateTime?

  sourceId     String?
  source       Source?      @relation(fields: [sourceId], references: [id])
}

// ===== Hệ thống phòng khám: chi nhánh, nhân viên, phân quyền, nhật ký =====

// Chi nhánh. Mọi bảng giao dịch về sau (kho, khám, hóa đơn) đều gắn branchId.
model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  staff     StaffBranch[]
  stockLots  StockLot[]
  stockMoves StockMove[]
}

// Nhân viên. role: OWNER | BRANCH_MANAGER | RECEPTION | DOCTOR | CASHIER | PHARMACIST | STOREKEEPER
// OWNER thấy mọi chi nhánh; các vai trò khác chỉ thấy chi nhánh được gán (StaffBranch).
model Staff {
  id           String    @id @default(cuid())
  username     String    @unique
  fullName     String
  passwordHash String
  role         String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  branches     StaffBranch[]
  auditLogs    AuditLog[]
}

model StaffBranch {
  staffId  String
  branchId String
  staff    Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([staffId, branchId])
}

// Nhật ký thao tác. Chỉ thêm, không sửa/xóa.
model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  staffId   String?
  staffName String?
  branchId  String?
  action    String // vd: LOGIN, LOGIN_FAILED, CREATE, UPDATE, DELETE
  entity    String // vd: Staff, Branch, Disease
  entityId  String?
  detail    String?

  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([entity, entityId])
}

// ---------- Kho và giá ----------

// Mặt hàng bán/dùng: dược liệu (tính theo gam) hoặc thành phẩm (viên, hộp, chai...).
model Item {
  id        String   @id @default(cuid())
  name      String
  type      String // HERB | PRODUCT
  unit      String // "g" cho dược liệu; viên/hộp/chai/... cho thành phẩm
  herbId    String? // liên kết vị thuốc trong phần tri thức (nếu trùng tên)
  herb      Herb?    @relation(fields: [herbId], references: [id], onDelete: SetNull)
  minStock  Float    @default(0) // dưới mức này thì cảnh báo sắp hết
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  prices ItemPrice[]
  lots   StockLot[]
  moves  StockMove[]

  @@index([name])
}

// Giá bán chung toàn hệ thống; giá hiện hành là dòng có effectiveFrom mới nhất. Giữ lịch sử.
model ItemPrice {
  id            String   @id @default(cuid())
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  price         Int // đồng / đơn vị (dược liệu: đồng / gam)
  effectiveFrom DateTime @default(now())
  staffName     String?

  @@index([itemId, effectiveFrom])
}

// Lô nhập: mỗi lần nhập là một lô, có giá nhập và hạn dùng.
model StockLot {
  id           String    @id @default(cuid())
  itemId       String
  item         Item      @relation(fields: [itemId], references: [id])
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id])
  supplier     String?
  receivedAt   DateTime  @default(now())
  expiryDate   DateTime?
  unitCost     Int // giá nhập / đơn vị
  qtyReceived  Float
  qtyRemaining Float
  note         String?
  staffName    String?
  moves        StockMove[]

  @@index([itemId, branchId])
}

// Sổ kho: mọi biến động đều có dòng ở đây (chỉ thêm). qty dương = nhập, âm = xuất.
model StockMove {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  lotId     String?
  lot       StockLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  type      String // RECEIPT | ADJUST
  qty       Float
  reason    String?
  staffName String?

  @@index([branchId, at])
  @@index([itemId])
}
